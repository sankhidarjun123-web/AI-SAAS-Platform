{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/old-about", "destination": "/about", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://example.com*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/submit.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
